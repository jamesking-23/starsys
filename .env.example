# Starsys has no build step: the browser app (src/main.js) only needs the public
# project URL and the ANON (publishable) key, set at the top of the module script
# in src/main.js under "CONFIG". Both are safe to expose in the browser.
#
# NEVER put the service_role key, database password or an access token in this
# repo or in src/main.js. Use these only for CLI / server-side work:
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
